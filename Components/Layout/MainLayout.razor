@using Microsoft.AspNetCore.Components.Authorization
@using RationesCurare.Functions

@inject NavigationManager NavigationManager
@inject RecurringTransactionManagement RecurringTransactionManagement

@inherits LayoutComponentBase

@if (IsAuthenticated)
{
    <nav class="menu">
        <NavLink href="balance/" Match="NavLinkMatch.All" ActiveClass="not-active" title="Balance">point_of_sale</NavLink>
        <NavLink href="accounts/" ActiveClass="not-active" title="Account Management">account_balance_wallet</NavLink>
        <NavLink href="transactions/" ActiveClass="not-active" title="Transactions">payments</NavLink>
        <NavLink href="recurring/" ActiveClass="not-active" title="Recurring transaction management">update</NavLink>
        <NavLink href="logout-cookie/" ActiveClass="not-active" title="Sign Out">logout</NavLink>
    </nav>
    <hr />
}

@Body

<button id="backToTop" class="back-to-top googleIcon" title="Back to top">
    arrow_upward
</button>

<script src="scroll.js"></script>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool IsAuthenticated;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            IsAuthenticated = user.Identity?.IsAuthenticated ?? false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RecurringTransactionManagement.ProcessPendingTransactionsAsync();
    }

}