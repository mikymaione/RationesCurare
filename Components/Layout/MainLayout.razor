@using RationesCurare.Functions

@inject NavigationManager NavigationManager
@inject DbSessionState SessionState

@inherits LayoutComponentBase

@if (SessionState.IsAuthenticated)
{
    <nav class="menu">
        <NavLink href="" Match="NavLinkMatch.All" ActiveClass="not-active" title="Balance">point_of_sale</NavLink>
        <NavLink href="accounts/" ActiveClass="not-active" title="Account Management">account_balance_wallet</NavLink>
        <NavLink href="transactions/" ActiveClass="not-active" title="Transactions">payments</NavLink>
        <NavLink href="recurring/" ActiveClass="not-active" title="Recurring transaction management">update</NavLink>
        <a @onclick="EseguiLogout" class="not-active" title="Log Out" style="cursor: pointer;">logout</a>
    </nav>
    <hr />
}

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    public void Dispose() =>
        SessionState.OnStateChanged -= RinfrescaMenu;

    protected override void OnInitialized() =>
        SessionState.OnStateChanged += RinfrescaMenu;    

    private void RinfrescaMenu() =>
        InvokeAsync(StateHasChanged);
    
    private void EseguiLogout()
    {
        SessionState.Logout();        
        NavigationManager.NavigateTo("/signin");
    }

}