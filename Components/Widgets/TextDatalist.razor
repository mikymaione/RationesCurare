<div>
    <input type="text" 
           value="@Value" 
           required="@Required"
           @oninput="OnInputChanged" 
           @onfocus="() => showDropdown = true"
           @onblur="HideDropdownWithDelay"
           @onkeydown="HandleKeyDown"
           placeholder="@Placeholder" 
           autocomplete="off" />

    @if (showDropdown && !string.IsNullOrEmpty(Value) && FilteredItems.Any())
    {
        var itemsList = FilteredItems.ToArray();

        <ul>
            @for (var i = 0; i < itemsList.Length; i++)
            {
                var item = itemsList[i];
                var x = i;
                
                <li class="cp @(x == activeIndex ? "active" : "")" @onclick="() => SelectItem(item)">
                    @item
                </li>
            }
        </ul>
    }
</div>

@code {

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? Value { get; set; }
    
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
    
    [Parameter]
    public IEnumerable<string> Items { get; set; } = [];
    
    [Parameter]
    public string? Placeholder { get; set; }
    
    [Parameter]
    public EventCallback OnSelected { get; set; }

    private bool showDropdown;
    private int activeIndex = -1;

    private IEnumerable<string> FilteredItems => 
        string.IsNullOrEmpty(Value) 
            ? Items 
            : Items.Where(i => i.Contains(Value, StringComparison.OrdinalIgnoreCase));

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        showDropdown = true;
        activeIndex = -1;
        await ValueChanged.InvokeAsync(Value);
        await OnSelected.InvokeAsync();
    }

    private async Task SelectItem(string item)
    {
        Value = item;
        showDropdown = false;
        activeIndex = -1;
        await ValueChanged.InvokeAsync(Value);
        await OnSelected.InvokeAsync();
    }

    private async Task HideDropdownWithDelay()
    {
        await Task.Delay(200);
        showDropdown = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var list = FilteredItems.ToList();
        if (!list.Any()) return;

        if (e.Key == "ArrowDown")
        {
            // Freccia GIÙ: aumenta l'indice (senza andare oltre la fine)
            if (activeIndex < list.Count - 1) activeIndex++;
        }
        else if (e.Key == "ArrowUp")
        {
            // Freccia SU: diminuisce l'indice (senza andare sotto lo zero)
            if (activeIndex > 0) activeIndex--;
        }
        else if (e.Key == "Enter")
        {
            // Tasto INVIO: se c'è un elemento selezionato, lo conferma
            if (activeIndex >= 0 && activeIndex < list.Count)
            {
                await SelectItem(list[activeIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            showDropdown = false;
            activeIndex = -1;
        }
    }

}