<div>
    <input type="text" 
           value="@Value" 
           required="@Required"
           @oninput="OnInputChanged" 
           @onfocus="() => showDropdown = true"
           @onblur="HideDropdownWithDelay"
           @onkeydown="HandleKeyDown"
           @onkeydown:preventDefault="preventDefault"
           placeholder="@Placeholder" />

    @if (showDropdown && !string.IsNullOrEmpty(Value) && Value.Length > 2 && FilteredItems.Any())
    {
        var itemsList = FilteredItems.ToArray();

        <ul class="datalist-dropdown">
            @for (var i = 0; i < itemsList.Length; i++)
            {
                var item = itemsList[i];
                var x = i;
                
                <li class="cp @(x == activeIndex ? "active" : "")" @onclick="() => SelectItem(item)">
                    @item
                </li>
            }
        </ul>
    }
</div>

@code {

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? Value { get; set; }
    
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
    
    [Parameter]
    public IEnumerable<string> Items { get; set; } = [];
    
    [Parameter]
    public string? Placeholder { get; set; }
    
    [Parameter]
    public EventCallback OnSelected { get; set; }

    private bool showDropdown, preventDefault;
    private int activeIndex = -1;

    private IEnumerable<string> FilteredItems => 
        string.IsNullOrEmpty(Value)
            ? Items
            : Items
                .Where(i =>
                    i.Contains(Value, StringComparison.OrdinalIgnoreCase)
                );

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        Value = $"{e.Value}";
        activeIndex = -1;

        if (!string.IsNullOrEmpty(Value) && Value.Length > 2)
            showDropdown = true;

        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SelectItem(string item)
    {
        Value = item;
        showDropdown = false;
        activeIndex = -1;
        await ValueChanged.InvokeAsync(Value);
        await OnSelected.InvokeAsync();
    }

    private async Task HideDropdownWithDelay()
    {
        await Task.Delay(200);
        showDropdown = false;
        await OnSelected.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        preventDefault = false;

        var list = FilteredItems
            .ToArray();
        
        if (list.Length < 1)
            return;

        if (e.Key == "ArrowDown")
        {
            preventDefault = true;

            // Freccia GIÙ: aumenta l'indice (senza andare oltre la fine)
            if (activeIndex < list.Length - 1)
                activeIndex++;
        }
        else if (e.Key == "ArrowUp")
        {
            preventDefault = true;

            // Freccia SU: diminuisce l'indice (senza andare sotto lo zero)
            if (activeIndex > 0)
                activeIndex--;
        }
        else if (e.Key == "Enter")
        {
            // Se il dropdown è visibile o c'è un elemento evidenziato, previene il submit del form
            if (showDropdown && activeIndex >= 0 && activeIndex < list.Length)
            {
                preventDefault = true;
                await SelectItem(list[activeIndex]);
            }
        }
        else if (e.Key == "Tab")
        {
            if (showDropdown && activeIndex >= 0 && activeIndex < list.Length)
                await SelectItem(list[activeIndex]);
        }
        else if (e.Key == "Escape")
        {
            showDropdown = false;
            activeIndex = -1;
        }
    }

}