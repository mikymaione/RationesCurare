@using RationesCurare.Functions
@using RationesCurare.Models

@if (cashFlowItems != null)
{    
    <table width="100%">
        <thead>
            <tr>
                <th>Year</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in cashFlowItems)
            {
                <tr>
                    <td align="right">
                        @group.Year
                    </td>
                    <td align="right" class="nw @GB.ClassColoreImporto(group.Balance)">
                        @GB.ToMoney(group.Balance)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
             <tr>
                <td># @cashFlowItems.Count</td>
                <td class="nw" align="right">
                    @GB.ToMoney(total)
                </td>
            </tr>
        </tfoot>
    </table>
}

@code {

    [Parameter]
    public List<CashFlow>? cashFlowItems { get; set; }  

    [Parameter]
    public double total { get; set; }

}