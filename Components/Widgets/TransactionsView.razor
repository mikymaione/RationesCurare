@using RationesCurare.Data
@using RationesCurare.Functions

@if (items != null)
{    
    <table width="100%">
        <thead>
            <tr>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in items)
            {
                <tr @onclick="() => OnDetail.InvokeAsync(x.Id)" style="cursor:pointer;">
                    <td>
                        <div>
                            @if (x.Idgiroconto > 0)
                            {
                                iconClass = "moneyNeutro";
                                iconTitle = "Transfer";
                                iconName = "currency_exchange";
                            }
                            else if (x.Soldi < 0)
                            {
                                iconClass = "moneyBad";
                                iconTitle = "Expense";
                                iconName = "arrow_downward";
                            }
                            else
                            {
                                iconClass = "moneyGood";
                                iconTitle = "Income";
                                iconName = "arrow_upward";
                            }
                            <span class="googleIcon fsInit @iconClass" title="@iconTitle">@iconName</span>                            
                            <span class="trLabelC">@GB.ToProperCase(x.Tipo)</span>
                            <span class="trLabel">@x.MacroArea</span>                            
                        </div>
                        <div><small>@x.Descrizione</small></div>
                        <div><ruby>@GB.ToDateTime(x.Data)</ruby></div>
                    </td>
                    <td align="right" class="nw @GB.ClassColoreImporto(x.Soldi)">
                        @GB.ToMoney(x.Soldi)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td># @itemsCount</td>
                <td class="nw" align="right">
                    @GB.ToMoney(total)
                </td>
            </tr>
        </tfoot>
    </table>    
}

@code {

    [Parameter]
    public List<Movimenti>? items { get; set; }

    [Parameter]
    public double itemsCount { get; set; }

    [Parameter]
    public double total { get; set; }

    [Parameter]
    public EventCallback<int> OnDetail { get; set; }

    private string? iconClass, iconTitle, iconName;

}