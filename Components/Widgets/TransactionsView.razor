@using RationesCurare.Data
@using RationesCurare.Functions

@if (items != null)
{    
    <table width="100%" class="responsive-table">
        <thead>
            <!-- Header > 745px -->
            <tr class="header-desktop">
                <th class="col-shrink"></th>
                <th class="col-shrink">Account</th>
                <th class="col-shrink">Category</th>
                <th class="col-expand">Description</th>
                <th class="col-shrink">Date</th>
                <th align="right" class="col-shrink">Amount</th>
            </tr>
            <!-- Header <= 745px -->
            <tr class="header-mobile">
                <th>Description</th>
                <th align="right">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in items)
            {
                if (x.Idgiroconto > 0)
                {
                    iconClass = "moneyNeutro";
                    iconTitle = "Transfer";
                    iconName = "currency_exchange";
                }
                else if (x.Soldi < 0)
                {
                    iconClass = "moneyBad";
                    iconTitle = "Expense";
                    iconName = "arrow_downward";
                }
                else
                {
                    iconClass = "moneyGood";
                    iconTitle = "Income";
                    iconName = "arrow_upward";
                }

                <tr @onclick="() => OnDetail.InvokeAsync(x.Id)" style="cursor:pointer;">
                    <!-- COLONNE DESKTOP (> 745px) -->
                    <td class="col-desktop col-shrink nw">
                        <span class="googleIcon fsInit @iconClass" title="@iconTitle">@iconName</span>
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @GB.ToProperCase(x.Tipo)
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @x.MacroArea
                    </td>
                    <td class="col-desktop col-expand">
                        @x.Descrizione
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @GB.ToDateTime(x.Data)
                    </td>

                    <!-- COLONNA MOBILE (<= 745px) -->
                    <td class="col-mobile">
                        <div>
                            <span class="googleIcon fsInit @iconClass" title="@iconTitle">@iconName</span>                            
                            <span class="trLabelC">@GB.ToProperCase(x.Tipo)</span>
                            <span class="trLabel">@x.MacroArea</span>                            
                        </div>
                        <div><small>@x.Descrizione</small></div>
                        <div><ruby>@GB.ToDateTime(x.Data)</ruby></div>
                    </td>

                    <!-- COLONNA SOLDI (Comune a entrambe) -->
                    <td align="right" class="nw col-shrink @GB.ClassColoreImporto(x.Soldi)">
                        @GB.ToMoney(x.Soldi)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="footer-desktop">
                <td colspan="5"># @itemsCount</td>
                <td class="nw" align="right">
                    @GB.ToMoney(total)
                </td>
            </tr>
            <tr class="footer-mobile">
                <td># @itemsCount</td>
                <td class="nw" align="right">
                    @GB.ToMoney(total)
                </td>
            </tr>
        </tfoot>
    </table>    
}

@code {

    [Parameter]
    public List<Movimenti>? items { get; set; }

    [Parameter]
    public double itemsCount { get; set; }

    [Parameter]
    public double total { get; set; }

    [Parameter]
    public EventCallback<int> OnDetail { get; set; }

    private string? iconClass, iconTitle, iconName;

}