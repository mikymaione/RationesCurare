@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Se non siamo su signin e la rotta non è vuota (ovvero non è la Home pubblica "/")
        if (!relativePath.StartsWith("signin", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(relativePath))
        {
            // Reindirizza semplicemente alla pagina di login, senza appendere parametri
            Navigation.NavigateTo("/signin", forceLoad: false);
        }
    }
}