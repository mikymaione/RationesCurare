@page "/transactions/"
@page "/transactions/{account}"

@using Microsoft.EntityFrameworkCore
@using RationesCurare.Data
@using RationesCurare.Functions
@using RationesCurare.Models
@using RationesCurare.Components.Widgets

@rendermode InteractiveServer

@inject AppDbContext Db
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>RationesCurare - @(account ?? "Balance")</PageTitle>

<h2>@(account ?? "Balance")</h2>

<h3>Settings & Filters</h3>
<div>
    <div>    
        <div class="bottomspace">
            <label for="filterViewType">View type:</label>
            <select id="filterViewType" @bind="filterViewType" @bind:after="ApplyFilters">
                @foreach (var type in Enum.GetValues<ViewType>())
                {
                    <option value="@type">@type.GetDescription()</option>
                }
            </select>
        </div>
    </div>
   
    <div>
        <!-- Date -->
        <div class="bottomspace div2Row">
            <div>
                <label for="dateFrom">Date from:</label>
                <input type="date" id="dateFrom" @bind="dateFrom" min="@minDate?.ToString("yyyy-MM-dd")" max="@maxDate?.ToString("yyyy-MM-dd")" placeholder="Date the transaction was performed" />
            </div>
            <div>
                <label for="dateTo">Date to:</label>
                <input type="date" id="dateTo" @bind="dateTo" min="@minDate?.ToString("yyyy-MM-dd")" max="@maxDate?.ToString("yyyy-MM-dd")" placeholder="Date the transaction was performed" />
            </div>
        </div>

        <!-- Amount -->
        <div class="bottomspace div2Row">
            <div>
                <label for="amountFrom">Amount from:</label>
                <input type="number" id="amountFrom" @bind="amountFrom" step="0.01" min="@minAmount" max="@maxAmount" placeholder="Transaction amount in money" />
            </div>
            <div>
                <label for="amountTo">Amount to:</label>
                <input type="number" id="amountTo" @bind="amountTo" step="0.01" min="@minAmount" max="@maxAmount" placeholder="Transaction amount in money" />
            </div>
        </div>

        <!-- Category -->
        <div class="bottomspace">
            <label for="category">Filter by category:</label>
            <input type="text" id="category" list="categoryList" @bind="filterCategory" placeholder="Category to which the transaction belongs" />
            <datalist id="categoryList">
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" />
                    }
                }
            </datalist>
        </div>

        <!-- Description -->
        <div class="bottomspace">
            <label for="description">Filter by description:</label>
            <input type="text" id="description" list="descriptionList" @bind="filterDescription" placeholder="Transaction description" />
            <datalist id="descriptionList">
                @if (descriptions != null)
                {
                    @foreach (var desc in descriptions)
                    {
                        <option value="@desc" />
                    }
                }
            </datalist>
        </div>

        <!-- Account -->
        <div class="bottomspace">
            <label for="filterAccount">Filter by account:</label>
            <select id="filterAccount" @bind="filterAccount" placeholder="Account from which the transaction was performed" >
                <option value="">«all accounts»</option>
                @if (accounts != null)
                {
                    @foreach (var acc in accounts)
                    {
                        <option value="@acc">@GB.ToProperCase(acc)</option>
                    }
                }
            </select>
        </div>
    </div>

    <!-- Buttons -->
    <div class="divSpaceBetween">
        <button @onclick="ApplyFilters">Apply filters</button>
        <button @onclick="ClearFilters">Clear filters</button>
    </div>
</div>

<h3>Transactions</h3>

@switch (filterViewType)
{
    case ViewType.All:
        <TransactionsView items="@items" itemsCount="@itemsCount" total="@total" OnDetail="Detail" />
        break;

    case ViewType.Annual:
        <AnnualCashFlowView cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.Monthly:
        <MonthlyCashFlowView cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.Trend:
        <AccountBalanceTrend cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.Breakdown:
        <ExpenseBreakdown breakdownItems="@breakdownItems" total="@total" />
        break;

    default:
        throw new ArgumentOutOfRangeException(nameof(filterViewType), $"Unsupported view type: {filterViewType}");
}

@if (hasMoreItems)
{
    <div @ref="scrollTrigger" style="height: 20px; background: transparent; text-align:center;">
        <ruby class="copyright">Loading...</ruby>
    </div>
}

<script>
    window.setupScrollObserver = (element, dotNetHelper) => {
        if (!element)
            return;

        const observer = new IntersectionObserver(async (entries) => {
            if (entries[0].isIntersecting) {
                await dotNetHelper.invokeMethodAsync('LoadMoreItemsFromJS');
            }
        }, {
            root: null,
            rootMargin: '0px',
            threshold: 1.0
        });

        observer.observe(element);
    };
</script>

<input class="myBtn googleIcon fsXXL" @onclick="NewTransaction" type="submit" title="New amount" value="local_atm" />

@code {

    [Parameter]
    public string? account { get; set; }    

    private List<CashFlow> cashFlowItems = new();
    private List<CategoryBreakdown> breakdownItems = new();
    private List<Movimenti> items = new();
    private double itemsCount;
    private double total;

    private const int pageSize = 50;
    private bool hasMoreItems = false;
    private ElementReference scrollTrigger;
    private IDisposable? dotNetRef;

    // Filter variables
    private ViewType filterViewType = ViewType.All;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private double? amountFrom;
    private double? amountTo;
    private string? filterCategory;
    private string? filterDescription;
    private string? filterAccount;

    // Min/Max values from database
    private DateTime? minDate;
    private DateTime? maxDate;
    private double? minAmount;
    private double? maxAmount;

    // Filter options
    private List<string> categories = new();
    private List<string> descriptions = new();
    private List<string> accounts = new();

    public void Dispose() =>
        dotNetRef?.Dispose();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        await CalculateTotal();
        await LoadNextBatch();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupScrollObserver", scrollTrigger, dotNetRef);
        }
    }

    [JSInvokable]
    public async Task LoadMoreItemsFromJS()
    {
        if (hasMoreItems)
        {
            await LoadNextBatch();
            StateHasChanged();
        }
    }

    private async Task LoadNextBatch()
    {
        var query = Db.Movimentis.AsQueryable();

        if (!string.IsNullOrEmpty(filterAccount))
            query = query.Where(m => m.Tipo.ToLower() == filterAccount.ToLower());

        if (dateFrom.HasValue)
            query = query.Where(m => m.Data >= dateFrom);

        if (dateTo.HasValue)
            query = query.Where(m => m.Data <= dateTo);

        if (amountFrom.HasValue)
            query = query.Where(m => m.Soldi >= amountFrom);

        if (amountTo.HasValue)
            query = query.Where(m => m.Soldi <= amountTo);

        if (!string.IsNullOrEmpty(filterCategory))
            query = query.Where(m => m.MacroArea.ToLower().Contains(filterCategory.ToLower()));

        if (!string.IsNullOrEmpty(filterDescription))
            query = query.Where(m => m.Descrizione.ToLower().Contains(filterDescription.ToLower()));

        switch (filterViewType)
        {
            case ViewType.All:
                var nextBatch = await query
                    .OrderByDescending(m => m.Data)
                    .Skip(items.Count)
                    .Take(pageSize)
                    .ToArrayAsync();

                hasMoreItems = nextBatch.Length == pageSize;
                items.AddRange(nextBatch);
                break;

            case ViewType.Monthly:
                // Project to an anonymous type first to avoid EF translation issues with record constructors,
                // letting SQL handle the grouping and SUM.
                var monthlyDataRaw = await query
                    .GroupBy(m => new { m.Data.Year, m.Data.Month })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Month = g.Key.Month,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderByDescending(g => g.Year)
                    .ThenByDescending(g => g.Month)
                    .ToListAsync();

                // Map the anonymous object to the CashFlow record in-memory
                foreach (var x in monthlyDataRaw)
                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: x.Month,
                        Balance: x.Balance
                    ));

                hasMoreItems = false;
                break;

            case ViewType.Breakdown:
                var breakdownRaw = await query
                    .Where(m => !string.IsNullOrEmpty(m.MacroArea))
                    .GroupBy(m => m.MacroArea)
                    .Select(g => new
                    {
                        Category = g.Key,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .ToListAsync();

                var breakdownSorted = breakdownRaw
                    .Where(b => b.Balance != 0)
                    .OrderByDescending(b => b.Balance)
                    .ToList();

                foreach (var x in breakdownSorted)
                    breakdownItems.Add(new(
                        Category: x.Category,
                        Balance: x.Balance
                    ));

                hasMoreItems = false;
                break;

            case ViewType.Annual:
                // Same safe approach for annual grouping
                var annualDataRaw = await query
                    .GroupBy(m => new { m.Data.Year })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderByDescending(g => g.Year)
                    .ToListAsync();

                foreach (var x in annualDataRaw)                
                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: null,
                        Balance: x.Balance
                    ));                

                hasMoreItems = false;
                break;

            case ViewType.Trend:
                var runningTotal = 0d;

                var trendDataRaw = await query
                    .GroupBy(m => new { m.Data.Year })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderBy(g => g.Year)
                    .ToListAsync();

                foreach (var x in trendDataRaw)
                {
                    runningTotal += x.Balance;

                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: null,
                        Balance: runningTotal
                    ));
                }

                cashFlowItems.Reverse();
                hasMoreItems = false;
                break;

            default:
                throw new ArgumentOutOfRangeException(nameof(filterViewType), filterViewType, $"Unsupported view type: {filterViewType}");
        }
    }

    private async Task LoadFilterOptions()
    {
        filterAccount = account;

        var baseQuery = Db.Movimentis.AsNoTracking();

        if (await baseQuery.AnyAsync())
        {
            minDate = await baseQuery.MinAsync(m => m.Data);
            maxDate = await baseQuery.MaxAsync(m => m.Data);
            minAmount = await baseQuery.MinAsync(m => (double?)m.Soldi);
            maxAmount = await baseQuery.MaxAsync(m => (double?)m.Soldi);
        }

        // Load unique categories
        categories = await baseQuery
            .Select(m => m.MacroArea)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        // Load unique descriptions
        descriptions = await baseQuery
            .Select(m => m.Descrizione)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        // Load all accounts
        accounts = await Db.Movimentis
            .Select(m => m.Tipo)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();
    }

    private async Task CalculateTotal()
    {
        var query = Db.Movimentis.AsQueryable();

        if (!string.IsNullOrEmpty(filterAccount))
            query = query.Where(m => m.Tipo.ToLower() == filterAccount.ToLower());

        if (dateFrom.HasValue)
            query = query.Where(m => m.Data >= dateFrom);

        if (dateTo.HasValue)
            query = query.Where(m => m.Data <= dateTo);

        if (amountFrom.HasValue)
            query = query.Where(m => m.Soldi >= amountFrom);

        if (amountTo.HasValue)
            query = query.Where(m => m.Soldi <= amountTo);

        if (!string.IsNullOrEmpty(filterCategory))
            query = query.Where(m => m.MacroArea.ToLower().Contains(filterCategory.ToLower()));

        if (!string.IsNullOrEmpty(filterDescription))
            query = query.Where(m => m.Descrizione.ToLower().Contains(filterDescription.ToLower()));

        itemsCount = await query
            .CountAsync();

        total = await query
            .Select(m => m.Soldi)
            .SumAsync();
    }

    private async Task ApplyFilters()
    {
        items.Clear();
        cashFlowItems.Clear();
        breakdownItems.Clear();

        hasMoreItems = true;

        await CalculateTotal();
        await LoadNextBatch();
    }

    private async Task ClearFilters()
    {
        dateFrom = null;
        dateTo = null;
        amountFrom = null;
        amountTo = null;
        filterCategory = "";
        filterDescription = "";
        filterAccount = account;

        items.Clear();
        cashFlowItems.Clear();
        breakdownItems.Clear();

        hasMoreItems = true;

        await CalculateTotal();
        await LoadNextBatch();
    }

    private void Detail(int id) =>
        NavigationManager.NavigateTo($"/transactions/{id}?returnUrl={System.Web.HttpUtility.UrlEncode(NavigationManager.Uri)}");

    private void NewTransaction() =>
        NavigationManager.NavigateTo($"/transactions/-1?returnUrl={System.Web.HttpUtility.UrlEncode(NavigationManager.Uri)}");
    
}