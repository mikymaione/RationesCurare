@page "/transactions/"
@page "/transactions/{account}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using RationesCurare.Data
@using RationesCurare.Functions
@using RationesCurare.Models
@using RationesCurare.Components.Charts
@using RationesCurare.Components.Widgets

@attribute [Authorize]

@rendermode InteractiveServer

@inject AppDbContext Db
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject LocalStorageManager LocalStorageManager

<PageTitle>RationesCurare - @TheTitle</PageTitle>

<h2>@TheTitle</h2>

<h3>Settings & Filters</h3>
<div>
    <div>    
        <div class="bottomspace">
            <label for="filterViewType">View type:</label>
            <select id="filterViewType" @bind="filterViewType" @bind:after="ApplyFilters">
                <option value="@ViewType.AllTransactions">All Transactions</option>

                <option value="@ViewType.ExpenseBreakdown">Expense Breakdown</option>

                <optgroup label="Cash Flow">
                    <option value="@ViewType.AnnualCashFlow">Annual Cash Flow</option>
                    <option value="@ViewType.MonthlyCashFlow">Monthly Cash Flow</option>
                </optgroup>

                <optgroup label="Account Balance Trend">
                    <option value="@ViewType.AnnualAccountBalanceTrend">Annual Account Balance Trend</option>
                    <option value="@ViewType.MonthlyAccountBalanceTrend">Monthly Account Balance Trend</option>
                </optgroup>
            </select>
        </div>
    </div>
   
    <div>
        <!-- Date -->
        <div class="bottomspace div2Row">
            <div>
                <label for="dateFrom">Date from:</label>
                <input type="date" id="dateFrom" @bind="dateFrom" min="@minDate?.ToString("yyyy-MM-dd")" max="@maxDate?.ToString("yyyy-MM-dd")" placeholder="Date the transaction was performed" />
            </div>
            <div>
                <label for="dateTo">Date to:</label>
                <input type="date" id="dateTo" @bind="dateTo" min="@minDate?.ToString("yyyy-MM-dd")" max="@maxDate?.ToString("yyyy-MM-dd")" placeholder="Date the transaction was performed" />
            </div>            
        </div>

        <!-- Quick Date Presets -->
        <div class="bottomspace date-presets-container">
            <button type="button" class="googleIcon" title="This Month" @onclick="SetThisMonth">calendar_month</button>
            <button type="button" class="googleIcon" title="Previous Month" @onclick="SetPreviousMonth">navigate_before</button>
            <button type="button" class="googleIcon" title="Next Month" @onclick="SetNextMonth">navigate_next</button>

            <button type="button" class="googleIcon" title="This Year" @onclick="SetThisYear">calendar_today</button>
            <button type="button" class="googleIcon" title="Previous Year" @onclick="SetPreviousYear">fast_rewind</button>
            <button type="button" class="googleIcon" title="Next Year" @onclick="SetNextYear">fast_forward</button>
        </div>

        <!-- Amount -->
        <div class="bottomspace div2Row">
            <div>
                <label for="amountFrom">Amount from:</label>
                <input type="number" id="amountFrom" @bind="amountFrom" step="0.01" min="@minAmount" max="@maxAmount" placeholder="Transaction amount in money" />
            </div>
            <div>
                <label for="amountTo">Amount to:</label>
                <input type="number" id="amountTo" @bind="amountTo" step="0.01" min="@minAmount" max="@maxAmount" placeholder="Transaction amount in money" />
            </div>
        </div>

        <!-- Category -->
        <div class="bottomspace">
            <label for="category">Filter by category:</label>
            <TextDatalist @bind-value="filterCategory" Items="categories" OnSelected="ApplyFilters" Placeholder="Category to which the transaction belongs" />
        </div>

        <!-- Description -->
        <div class="bottomspace">
            <label for="description">Filter by description:</label>
            <TextDatalist @bind-value="filterDescription" Items="descriptions" OnSelected="ApplyFilters" Placeholder="Transaction description" />
        </div>
        
        <!-- Account -->
        <div class="bottomspace">
            <label for="filterAccount">Filter by account:</label>
            <select id="filterAccount" @bind="filterAccount" placeholder="Account from which the transaction was performed" >
                <option value="">«all accounts»</option>
                @if (accounts != null)
                {
                    @foreach (var acc in accounts)
                    {
                        <option value="@acc">@GB.ToProperCase(acc)</option>
                    }
                }
            </select>
        </div>
    </div>

    <!-- Buttons -->
    <div class="divSpaceBetween">
        <button @onclick="ApplyFilters" title="Apply the selected filters">Apply filters</button>
        <button @onclick="ClearFilters" title="Clear all applied filters">Clear filters</button>
    </div>
</div>

<br />

@switch (filterViewType)
{
    case ViewType.ExpenseBreakdown:
        <ExpenseBreakdownChart @ref="expenseBreakdownChart" Data="@breakdownItems" />
        break;

    case ViewType.AnnualAccountBalanceTrend:
    case ViewType.MonthlyAccountBalanceTrend:
        <AccountBalanceTrendChart @ref="accountBalanceTrendChart" Data="@cashFlowItems" viewType="@filterViewType" />
        break;

    case ViewType.AnnualCashFlow:
    case ViewType.MonthlyCashFlow:
        <CashFlowChart @ref="cashFlowChart" Data="@cashFlowItems" viewType="@filterViewType" />
        break;

    default:
        break;
}

@switch (filterViewType)
{
    case ViewType.AllTransactions:
        <TransactionsView items="@items" itemsCount="@itemsCount" total="@total" OnDetail="Detail" />
        break;

    case ViewType.AnnualCashFlow:
        <AnnualCashFlowView cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.MonthlyCashFlow:
        <MonthlyCashFlowView cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.AnnualAccountBalanceTrend:
        <AnnualAccountBalanceTrend cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.MonthlyAccountBalanceTrend:
        <MonthlyAccountBalanceTrend cashFlowItems="@cashFlowItems" total="@total" />
        break;

    case ViewType.ExpenseBreakdown:
        <ExpenseBreakdown breakdownItems="@breakdownItems" total="@total" />
        break;

    default:
        throw new ArgumentOutOfRangeException(nameof(filterViewType), $"Unsupported view type: {filterViewType}");
}

@if (hasMoreItems)
{
    <div @ref="scrollTrigger" style="height: 20px; background: transparent; text-align:center;">
        <ruby class="copyright">Loading...</ruby>
    </div>
}

<script>
    window.setupScrollObserver = (element, dotNetHelper) => {
        if (!element)
            return;

        const observer = new IntersectionObserver(async (entries) => {
            if (entries[0].isIntersecting) {
                await dotNetHelper.invokeMethodAsync('LoadMoreItemsFromJS');
            }
        }, {
            root: null,
            rootMargin: '0px',
            threshold: 1.0
        });

        observer.observe(element);
    };
</script>

<input class="myBtn googleIcon fsXXL" @onclick="NewTransaction" type="submit" title="New transaction" value="local_atm" />

@code {

    [Parameter]
    public string? account { get; set; }        

    private AccountBalanceTrendChart? accountBalanceTrendChart;
    private ExpenseBreakdownChart? expenseBreakdownChart;
    private CashFlowChart? cashFlowChart;

    string TheTitle =>
        string.IsNullOrEmpty(account)
            ? "Transactions"
            : $"Transactions of {account}";
    string TheSubTitle =>
        string.IsNullOrEmpty(account)
            ? "Content"
            : $"Content of {account}";

    private List<CashFlow> cashFlowItems = new();
    private List<CategoryBreakdown> breakdownItems = new();
    private List<Movimenti> items = new();
    private int itemsCount;
    private double total;

    private const int pageSize = 50;
    private bool hasMoreItems = false;
    private ElementReference scrollTrigger;
    private IDisposable? dotNetRef;

    // Filter variables
    private ViewType filterViewType = ViewType.AllTransactions;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private double? amountFrom;
    private double? amountTo;
    private string? filterCategory;
    private string? filterDescription;
    private string? filterAccount;

    // Min/Max values from database
    private DateTime? minDate;
    private DateTime? maxDate;
    private double? minAmount;
    private double? maxAmount;

    // Filter options
    private List<string> categories = new();
    private List<string> descriptions = new();
    private List<string> accounts = new();

    public void Dispose() =>
        dotNetRef?.Dispose();

    protected override Task OnInitializedAsync() =>
        LoadFilterOptions();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);

            await LoadFilters();
            await ApplyFilters();

            StateHasChanged();
        }

        if (hasMoreItems && scrollTrigger.Context != null)
            await JS.InvokeVoidAsync("setupScrollObserver", scrollTrigger, dotNetRef);
    }

    [JSInvokable]
    public async Task LoadMoreItemsFromJS()
    {
        if (hasMoreItems)
        {
            await LoadNextBatch();
            StateHasChanged();
        }
    }

    private async Task LoadNextBatch()
    {
        await SaveFilters();

        var query = Db.Movimentis.AsQueryable();

        if (!string.IsNullOrEmpty(filterAccount))
            query = query.Where(m => m.Tipo.ToLower() == filterAccount.ToLower());

        if (dateFrom.HasValue)
            query = query.Where(m => m.Data >= dateFrom);

        if (dateTo.HasValue)
            query = query.Where(m => m.Data <= dateTo);

        if (amountFrom.HasValue)
            query = query.Where(m => m.Soldi >= amountFrom);

        if (amountTo.HasValue)
            query = query.Where(m => m.Soldi <= amountTo);

        if (!string.IsNullOrEmpty(filterCategory))
            query = query.Where(m => m.MacroArea.ToLower().Contains(filterCategory.ToLower()));

        if (!string.IsNullOrEmpty(filterDescription))
            query = query.Where(m => m.Descrizione.ToLower().Contains(filterDescription.ToLower()));

        switch (filterViewType)
        {
            case ViewType.AllTransactions:
                var nextBatch = await query
                    .OrderByDescending(m => m.Data)
                    .Skip(items.Count)
                    .Take(pageSize)
                    .ToArrayAsync();

                hasMoreItems = nextBatch.Length == pageSize;
                items.AddRange(nextBatch);
                break;

            case ViewType.MonthlyCashFlow:
                // Project to an anonymous type first to avoid EF translation issues with record constructors,
                // letting SQL handle the grouping and SUM.
                var monthlyDataRaw = await query
                    .GroupBy(m => new { m.Data.Year, m.Data.Month })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Month = g.Key.Month,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderByDescending(g => g.Year)
                    .ThenByDescending(g => g.Month)
                    .ToListAsync();

                // Map the anonymous object to the CashFlow record in-memory
                foreach (var x in monthlyDataRaw)
                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: x.Month,
                        Balance: x.Balance
                    ));

                hasMoreItems = false;
                break;

            case ViewType.ExpenseBreakdown:
                var breakdownRaw = await query
                    .Where(m => !string.IsNullOrEmpty(m.MacroArea))
                    .GroupBy(m => m.MacroArea)
                    .Select(g => new
                    {
                        Category = g.Key,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .ToListAsync();

                var positives = breakdownRaw
                    .Where(b => b.Balance > 0)
                    .OrderByDescending(b => b.Balance);

                var negatives = breakdownRaw
                    .Where(b => b.Balance < 0)
                    .OrderBy(b => b.Balance);

                var breakdownSorted = positives.Concat(negatives).ToList();

                foreach (var x in breakdownSorted)
                    breakdownItems.Add(new(
                        Category: x.Category,
                        Balance: x.Balance
                    ));

                hasMoreItems = false;
                break;

            case ViewType.AnnualCashFlow:
                // Same safe approach for annual grouping
                var annualDataRaw = await query
                    .GroupBy(m => new { m.Data.Year })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderByDescending(g => g.Year)
                    .ToListAsync();

                foreach (var x in annualDataRaw)                
                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: null,
                        Balance: x.Balance
                    ));                

                hasMoreItems = false;
                break;

            case ViewType.AnnualAccountBalanceTrend:
                var runningTotal = 0d;

                var trendDataRaw = await query
                    .GroupBy(m => new { m.Data.Year })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderBy(g => g.Year)
                    .ToListAsync();

                foreach (var x in trendDataRaw)
                {
                    runningTotal += x.Balance;

                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: null,
                        Balance: runningTotal
                    ));
                }

                cashFlowItems.Reverse();
                hasMoreItems = false;
                break;

            case ViewType.MonthlyAccountBalanceTrend:
                var runningTotalMonthly = 0d;

                var trendMonthlyDataRaw = await query
                    .GroupBy(m => new { m.Data.Year, m.Data.Month })
                    .Select(g => new
                    {
                        Year = g.Key.Year,
                        Month = g.Key.Month,
                        Balance = g.Sum(m => m.Soldi)
                    })
                    .OrderBy(g => g.Year)
                    .ThenBy(g => g.Month)
                    .ToListAsync();

                foreach (var x in trendMonthlyDataRaw)
                {
                    runningTotalMonthly += x.Balance;

                    cashFlowItems.Add(new(
                        Year: x.Year,
                        Month: x.Month,
                        Balance: runningTotalMonthly
                    ));
                }

                cashFlowItems.Reverse();
                hasMoreItems = false;
                break;

            default:
                throw new ArgumentOutOfRangeException(nameof(filterViewType), filterViewType, $"Unsupported view type: {filterViewType}");
        }

        switch (filterViewType)
        {
            case ViewType.ExpenseBreakdown:
                if (expenseBreakdownChart != null)    
                    await expenseBreakdownChart.AggiornaGraficoAsync();    
                break;

            case ViewType.AnnualCashFlow:
            case ViewType.MonthlyCashFlow:
                if (cashFlowChart != null)    
                    await cashFlowChart.AggiornaGraficoAsync();
                break;

            case ViewType.AnnualAccountBalanceTrend:
            case ViewType.MonthlyAccountBalanceTrend:
                if (accountBalanceTrendChart != null)    
                    await accountBalanceTrendChart.AggiornaGraficoAsync();    
                break;

            default:
                break;
        }
    }

    private async Task LoadFilterOptions()
    {
        filterAccount = account;

        var baseQuery = Db.Movimentis.AsNoTracking();

        if (await baseQuery.AnyAsync())
        {
            minDate = await baseQuery.MinAsync(m => m.Data);
            maxDate = await baseQuery.MaxAsync(m => m.Data);
            minAmount = await baseQuery.MinAsync(m => (double?)m.Soldi);
            maxAmount = await baseQuery.MaxAsync(m => (double?)m.Soldi);
        }

        // Load unique categories
        categories = await baseQuery
            .Select(m => m.MacroArea)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        // Load unique descriptions
        descriptions = await baseQuery
            .Select(m => m.Descrizione)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        // Load all accounts
        accounts = await Db.Movimentis
            .Select(m => m.Tipo)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();
    }

    private async Task CalculateTotal()
    {
        var query = Db.Movimentis.AsQueryable();

        if (!string.IsNullOrEmpty(filterAccount))
            query = query.Where(m => m.Tipo.ToLower() == filterAccount.ToLower());

        if (dateFrom.HasValue)
            query = query.Where(m => m.Data >= dateFrom);

        if (dateTo.HasValue)
            query = query.Where(m => m.Data <= dateTo);

        if (amountFrom.HasValue)
            query = query.Where(m => m.Soldi >= amountFrom);

        if (amountTo.HasValue)
            query = query.Where(m => m.Soldi <= amountTo);

        if (!string.IsNullOrEmpty(filterCategory))
            query = query.Where(m => m.MacroArea.ToLower().Contains(filterCategory.ToLower()));

        if (!string.IsNullOrEmpty(filterDescription))
            query = query.Where(m => m.Descrizione.ToLower().Contains(filterDescription.ToLower()));

        itemsCount = await query
            .CountAsync();

        total = await query
            .Select(m => m.Soldi)
            .SumAsync();
    }

    private async Task ApplyFilters()
    {
        items.Clear();
        cashFlowItems.Clear();
        breakdownItems.Clear();

        hasMoreItems = true;

        await CalculateTotal();
        await LoadNextBatch();
    }

    private async Task LoadFilters()
    {
        await LocalStorageManager.IfNotInitializeKeysAsync("Transactions");

        filterViewType = await LocalStorageManager.GetItemAsync<ViewType>("filterViewType", ViewType.AllTransactions);
        dateFrom = await LocalStorageManager.GetItemAsync<DateTime?>("dateFrom", null);
        dateTo = await LocalStorageManager.GetItemAsync<DateTime?>("dateTo", null);
        amountFrom = await LocalStorageManager.GetItemAsync<double?>("amountFrom", null);
        amountTo = await LocalStorageManager.GetItemAsync<double?>("amountTo", null);
        filterCategory = await LocalStorageManager.GetItemAsync<string?>("filterCategory", string.Empty);
        filterDescription = await LocalStorageManager.GetItemAsync<string?>("filterDescription", string.Empty);
        filterAccount = await LocalStorageManager.GetItemAsync<string?>("filterAccount", account);
    }

    private async Task SaveFilters()
    {
        if (LocalStorageManager.IsReady("Transactions"))
        {
            await LocalStorageManager.SetItemAsync("filterViewType", filterViewType);
            await LocalStorageManager.SetItemAsync("dateFrom", dateFrom);
            await LocalStorageManager.SetItemAsync("dateTo", dateTo);
            await LocalStorageManager.SetItemAsync("amountFrom", amountFrom);
            await LocalStorageManager.SetItemAsync("amountTo", amountTo);
            await LocalStorageManager.SetItemAsync("filterCategory", filterCategory);
            await LocalStorageManager.SetItemAsync("filterDescription", filterDescription);
            await LocalStorageManager.SetItemAsync("filterAccount", filterAccount);
        }
    }

    private async Task ClearFilters()
    {
        dateFrom = null;
        dateTo = null;
        amountFrom = null;
        amountTo = null;
        filterCategory = "";
        filterDescription = "";
        filterAccount = account;

        items.Clear();
        cashFlowItems.Clear();
        breakdownItems.Clear();

        hasMoreItems = true;

        await CalculateTotal();
        await LoadNextBatch();
    }

    private void Detail(int id) 
    {
        // Se stiamo creando una nuova transazione (id == -1) e abbiamo un account selezionato, lo passiamo in query string
        var qsAccount = id == -1 && !string.IsNullOrEmpty(account)
            ? $"&defaultAccount={System.Web.HttpUtility.UrlEncode(account)}"
            : string.Empty;

        NavigationManager.NavigateTo($"/transactions/{id}?returnUrl={System.Web.HttpUtility.UrlEncode(NavigationManager.Uri)}{qsAccount}");
    }

    private void NewTransaction() =>
        Detail(-1);


    private async Task SetThisMonth()
    {
        var today = DateTime.Today;
        dateFrom = new DateTime(today.Year, today.Month, 1);
        dateTo = dateFrom.Value.AddMonths(1).AddDays(-1);
        await ApplyFilters();
    }

    private async Task SetPreviousMonth()
    {
        var baseDate = dateFrom ?? DateTime.Today;
        var targetDate = new DateTime(baseDate.Year, baseDate.Month, 1).AddMonths(-1);
        
        dateFrom = targetDate;
        dateTo = targetDate.AddMonths(1).AddDays(-1);
        await ApplyFilters();
    }

    private async Task SetNextMonth()
    {
        var baseDate = dateFrom ?? DateTime.Today;
        var targetDate = new DateTime(baseDate.Year, baseDate.Month, 1).AddMonths(1);
        
        dateFrom = targetDate;
        dateTo = targetDate.AddMonths(1).AddDays(-1);
        await ApplyFilters();
    }

    private async Task SetThisYear()
    {
        var today = DateTime.Today;
        dateFrom = new DateTime(today.Year, 1, 1);
        dateTo = new DateTime(today.Year, 12, 31);
        await ApplyFilters();
    }

    private async Task SetPreviousYear()
    {
        var baseYear = (dateFrom ?? DateTime.Today).Year - 1;
        
        dateFrom = new DateTime(baseYear, 1, 1);
        dateTo = new DateTime(baseYear, 12, 31);
        await ApplyFilters();
    }

    private async Task SetNextYear()
    {
        var baseYear = (dateFrom ?? DateTime.Today).Year + 1;
        
        dateFrom = new DateTime(baseYear, 1, 1);
        dateTo = new DateTime(baseYear, 12, 31);
        await ApplyFilters();
    }    

}