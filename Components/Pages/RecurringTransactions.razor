@page "/recurring"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using RationesCurare.Data
@using RationesCurare.Functions

@attribute [Authorize]

@rendermode InteractiveServer

@inject AppDbContext Db
@inject NavigationManager NavigationManager

<PageTitle>RationesCurare - Recurring transaction management</PageTitle>

<h2>Recurring Transaction Management</h2>

@if (items != null)
{
    <table width="100%" class="responsive-table">
        <thead>
            <!-- Header > 745px -->
            <tr class="header-desktop">
                <th class="col-shrink">Account</th>
                <th class="col-shrink">Category</th>
                <th class="col-expand">Description</th>
                <th class="col-shrink">Periodicity</th>
                <th class="col-shrink">Due date</th>
                <th align="right" class="col-shrink">Amount</th>
            </tr>
            <!-- Header <= 745px -->
            <tr class="header-mobile">
                <th>Description</th>
                <th align="right">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in items)
            {
                <tr @onclick="() => Detail(x.Id)" style="cursor:pointer;">
                    <!-- COLONNE DESKTOP (> 745px) -->
                    <td class="col-desktop col-shrink nw">
                        @GB.ToProperCase(x.Tipo)
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @x.MacroArea
                    </td>
                    <td class="col-desktop col-expand">
                        @x.Descrizione
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @x.Periodo_H
                    </td>
                    <td class="col-desktop col-shrink nw">
                        @GB.ToDate(x.GiornoDelMese)
                    </td>

                    <!-- COLONNA MOBILE (<= 745px) -->
                    <td class="col-mobile">
                        <div>
                            <span class="trLabelC">@GB.ToProperCase(x.Tipo)</span>
                            <span class="trLabel">@x.MacroArea</span>
                        </div>
                        <div><small>@x.Descrizione</small></div>
                        <div><ruby>@GB.ToDate(x.GiornoDelMese)</ruby> - @x.Periodo_H</div>
                    </td>

                    <!-- COLONNA SOLDI (Comune a entrambe le viste) -->
                    <td align="right" class="nw col-shrink @GB.ClassColoreImporto(x.Soldi)">
                        @GB.ToMoney(x.Soldi)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="footer-desktop">
                <td colspan="6"># @items.Count</td>
            </tr>
            <tr class="footer-mobile">
                <td colspan="2"># @items.Count</td>
            </tr>
        </tfoot>
    </table>
}

<input class="myBtn googleIcon fsXXL" @onclick="NewRecurringTransaction" type="submit" title="New recurring transaction" value="update" />

@code {
    private List<MovimentiTempo>? items;

    protected override async Task OnInitializedAsync() =>
        items = await Db.MovimentiTempos
            .OrderBy(x => x.GiornoDelMese)
            .ToListAsync();

    private void Detail(int id) =>
        NavigationManager.NavigateTo($"/recurring/{id}");

    private void NewRecurringTransaction() =>
        Detail(-1);

}