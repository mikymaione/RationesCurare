@page "/transactions/{id:int}"

@using Microsoft.EntityFrameworkCore
@using RationesCurare.Data
@using RationesCurare.Functions
@using Microsoft.AspNetCore.WebUtilities

@rendermode InteractiveServer

@inject AppDbContext Db
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@if (id == -1)
{
    <PageTitle>RationesCurare - New transaction</PageTitle>
    <h2>New transaction</h2>
}
else
{
    <PageTitle>RationesCurare - Edit transaction @id</PageTitle>
    <h2>Edit transaction @id</h2>
}

<div>
    <div class="bottomspace">
        <label for="fromAccount">From account</label>
        <select id="fromAccount" @bind="fromAccount" required>
            <option value="">«select account»</option>
            @foreach (var acc in accounts)
            {
                <option value="@acc">@GB.ToProperCase(acc)</option>
            }
        </select>
    </div>

    <div class="bottomspace">
        <label for="toAccount">To account</label>
        <select id="toAccount" @bind="toAccount">
            <option value="">«no account»</option>
            @foreach (var acc in accounts)
            {
                <option value="@acc">@GB.ToProperCase(acc)</option>
            }
        </select>
    </div>

    <div class="bottomspace">
        <label for="amount">Transaction amount</label>
        <input type="number" id="amount" @bind="amount" step="0.01" min="-10000000" max="10000000" required placeholder="Transaction amount in money" />
    </div>

    <div class="bottomspace">
        <label for="dateEdit">Date</label>
        <input type="datetime-local" id="dateEdit" @bind="date" required placeholder="Date the transaction was performed" />
    </div>

    <div class="bottomspace">
        <label for="description">Description</label>
        <input type="text" id="description" list="descriptionList" @bind="description" @onblur="OnDescriptionBlur" data-minchars="1" required autocomplete="off" placeholder="Operation Description" />
        <datalist id="descriptionList">
            @foreach (var desc in descriptions)
            {
                <option value="@desc" />
            }
        </datalist>
    </div>

    <div class="bottomspace">
        <label for="category">Category</label>
        <input type="text" id="category" list="categoryList" @bind="category" data-minchars="1" maxlength="250" required autocomplete="off" placeholder="Category to which the transaction belongs" />
        <datalist id="categoryList">
            @foreach (var cat in categories)
            {
                <option value="@cat" />
            }
        </datalist>
    </div>

    <div class="bottomspace">
        <label for="author">Author</label>
        <input type="text" id="author" @bind="author"  maxlength="255" autocomplete="on" required placeholder="Author of the transaction" />
    </div>

    <div class="divSpaceBetween">
        <button @onclick="SaveTransaction">Save</button>
        @if (id > -1)
        {
            <button @onclick="DeleteTransaction">Delete</button>
        }
    </div>
</div>

@code {

    [Parameter]
    public int? id { get; set; }

    private List<string> accounts = new();
    private List<string> categories = new();
    private List<string> descriptions = new();

    private string? fromAccount;
    private string? toAccount;
    private double? amount;
    private DateTime date = DateTime.Now;
    private string? description;
    private string? category;
    private string? author;
    private string returnUrl = "/transactions/";

    protected override async Task OnInitializedAsync()
    {
        // Extract returnUrl from query string
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var value))
            returnUrl = value.ToString();

        await LoadOptions();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTransaction();
    }

    private async Task LoadOptions()
    {
        var baseQuery = Db.Movimentis.AsQueryable();

        categories = await baseQuery
            .Select(m => m.MacroArea)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        descriptions = await baseQuery
            .Select(m => m.Descrizione)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        accounts = await Db.Casses
            .Where(c => c.Nascondi != true)
            .Select(c => c.Nome)
            .Where(m => !string.IsNullOrEmpty(m))
            .OrderBy(m => m)
            .ToListAsync();
    }

    private async Task LoadTransaction()
    {
        if (id > -1)
        {
            var t = await Db.Movimentis.FindAsync(id);

            if (t != null)
            {
                fromAccount = t.Tipo;
                toAccount = t.IdgirocontoNavigation?.Tipo;
                amount = t.Soldi;
                date = t.Data;
                description = t.Descrizione;
                category = t.MacroArea;
                author = t.Nome;
            }
        }
        else
        {
            fromAccount = null;
            toAccount = null;
            amount = null;
            date = DateTime.Now;
            description = null;
            category = null;
            author = null;
        }
    }

    private async Task SaveTransaction()
    {
        var t = id > -1
            ? await Db.Movimentis.FindAsync(id.Value) ?? throw new Exception("Transaction not found")
            : new();

        t.Tipo = fromAccount ?? throw new Exception("From account is required");
        t.Soldi = amount.GetValueOrDefault();
        t.Data = date;
        t.Descrizione = description ?? string.Empty;
        t.MacroArea = category ?? string.Empty;
        t.Nome = author ?? throw new Exception("Author is required");

        if (id > -1)
            Db.Movimentis.Update(t);
        else
            Db.Movimentis.Add(t);

        await Db.SaveChangesAsync();
        NavigationManager.NavigateTo(returnUrl);
    }

    private async Task DeleteTransaction()
    {
        if (id > -1)
        {
            var transaction = await Db.Movimentis.FindAsync(id.Value);

            var confirmationMessage = transaction?.Idgiroconto > -1
                ? "Are you sure you want to delete this internal transfer? Both linked transactions will be removed."
                : "Are you sure you want to delete this transaction?";
            
            var confermato = await JS.InvokeAsync<bool>("confirm", confirmationMessage);
            
            if (confermato && transaction != null)
            {
                if (transaction.Idgiroconto > -1)
                {
                    var linkedTransaction = await Db.Movimentis.FindAsync(transaction.Idgiroconto.Value);

                    if (linkedTransaction != null)
                    {
                        // Step 1: Break the circular foreign key references in the database
                        transaction.Idgiroconto = null;
                        linkedTransaction.Idgiroconto = null;
                        
                        // Push this change to the DB so the constraints are cleared
                        await Db.SaveChangesAsync();

                        // Step 2: Now that they are completely independent, safe to delete
                        Db.Movimentis.Remove(linkedTransaction);
                    }
                }

                Db.Movimentis.Remove(transaction);
                
                // Save the deletions
                await Db.SaveChangesAsync();
                
                NavigationManager.NavigateTo(returnUrl);
            }
        }
    }

    private async Task OnDescriptionBlur()
    {
        if (!string.IsNullOrWhiteSpace(description))
        {
            var suggestedCategory = await Db.Movimentis
                .Where(m => m.Descrizione == description)
                .GroupBy(m => m.MacroArea)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .FirstOrDefaultAsync();

            if (!string.IsNullOrWhiteSpace(suggestedCategory))
                category = suggestedCategory;
        }
    }

}