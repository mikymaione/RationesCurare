@page "/transactions/{id:int}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using RationesCurare.Data
@using RationesCurare.Functions
@using RationesCurare.Components.Widgets

@attribute [Authorize]

@rendermode InteractiveServer

@inject AppDbContext Db
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@if (id == -1)
{
    <PageTitle>RationesCurare - New transaction</PageTitle>
    <h2>New transaction</h2>
}
else
{
    <PageTitle>RationesCurare - Edit transaction #@id</PageTitle>
    <h2>Edit transaction #@id</h2>
}

<form @onsubmit="SaveTransaction">
    <div class="form-group bottomspace">
        <label for="fromAccount">From account</label>
        <select id="fromAccount" @bind="fromAccount" required>
            <option value="">«select account»</option>
            @foreach (var acc in accounts)
            {
                <option value="@acc">@GB.ToProperCase(acc)</option>
            }
        </select>
    </div>

    <div class="form-group bottomspace">
        <label for="toAccount">To account</label>
        <select id="toAccount" @bind="toAccount">
            <option value="">«no account»</option>
            @foreach (var acc in accounts)
            {
                <option value="@acc">@GB.ToProperCase(acc)</option>
            }
        </select>
    </div>

    <div class="form-group bottomspace">
        <label for="amount">Transaction amount</label>
        <input type="number" id="amount" @bind="amount" step="0.01" min="-10000000" max="10000000" required placeholder="Transaction amount in money" />
    </div>

    <div class="form-group bottomspace">
        <label for="dateEdit">Date</label>
        <input type="datetime-local" id="dateEdit" @bind="date" required placeholder="Date the transaction was performed" />
    </div>

    <div class="form-group bottomspace">
        <label for="description">Description</label>
        <TextDatalist @bind-Value="description" Items="descriptions" OnSelected="OnDescriptionBlur" Placeholder="Operation Description" Required="@(!IsGiroconto)" />
    </div>

    <div class="form-group bottomspace">
        <label for="category">Category</label>
        <TextDatalist @bind-Value="category" Items="categories" Placeholder="Category to which the transaction belongs" Required="@(!IsGiroconto)" />
    </div>    

    <div class="form-group bottomspace">
        <label for="author">Author</label>
        <input type="text" id="author" @bind="author" maxlength="255" autocomplete="on" required placeholder="Author of the transaction" />
    </div>

    <div class="divSpaceBetween">
        <button type="submit">Save</button>
        @if (id > -1)
        {
            <button type="button" @onclick="DeleteTransaction">Delete</button>
        }
    </div>
    
    @if (amount.HasValue && amount != 0)
    {
        <h3>Summary</h3>
        @if (!string.IsNullOrEmpty(fromAccount) && !string.IsNullOrEmpty(toAccount))
        {
            <p>@GB.ToMoney(amount) @GB.MoneyDirection(amount.GetValueOrDefault(), isTransfer: true) @fromAccount</p>
            <p>@GB.ToMoney(-amount) @GB.MoneyDirection(-amount.GetValueOrDefault(), isTransfer: true) @toAccount</p>
        }
        else if (!string.IsNullOrEmpty(fromAccount))
        {
            <p>@GB.ToMoney(amount) @GB.MoneyDirection(amount.GetValueOrDefault(), isTransfer: false) @fromAccount</p>
        }
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <h3 class="mytextcolor">Error</h3>
        <p class="mytextcolor giustificato">@error</p>
    }
</form>

@code {

    [Parameter]
    public int? id { get; set; }

    private List<string> accounts = new();
    private List<string> categories = new();
    private List<string> descriptions = new();

    private string? fromAccount;
    private string? toAccount;
    private double? amount;
    private DateTime date = DateTime.Now;
    private string? description;
    private string? category;
    private string? author;
    private string returnUrl = "/transactions/";
    private string? defaultAccountFromQuery;

    private string error = string.Empty;

    private bool IsGiroconto =>
        !string.IsNullOrEmpty(fromAccount)
        && !string.IsNullOrEmpty(toAccount);

    protected override async Task OnInitializedAsync()
    {
        // Extract returnUrl from query string
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var value))
            returnUrl = value.ToString();

        // Estraiamo l'eventuale account di default
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("defaultAccount", out var accValue))
            defaultAccountFromQuery = accValue.ToString();

        await LoadOptions();
    }

    protected override Task OnParametersSetAsync() =>
        LoadTransaction();

    private async Task LoadOptions()
    {
        var baseQuery = Db.Movimentis.AsQueryable();

        categories = await baseQuery
            .Select(m => m.MacroArea)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        descriptions = await baseQuery
            .Select(m => m.Descrizione)
            .Where(m => !string.IsNullOrEmpty(m))
            .Distinct()
            .OrderBy(m => m)
            .ToListAsync();

        accounts = await Db.Casses
            .Where(c => c.Nascondi != true)
            .Select(c => c.Nome)
            .Where(m => !string.IsNullOrEmpty(m))
            .OrderBy(m => m)
            .ToListAsync();
    }

    private async Task LoadTransaction()
    {
        if (id > -1)
        {
            var t = await Db.Movimentis
                .Include(m => m.IdgirocontoNavigation)
                .FirstOrDefaultAsync(m => m.Id == id.Value)
                ?? throw new Exception("Transaction not found");
            
            fromAccount = t.Tipo;
            toAccount = t.IdgirocontoNavigation?.Tipo;
            amount = t.Soldi;
            date = t.Data;
            description = t.Descrizione;
            category = t.MacroArea;
            author = t.Nome;
        }
        else
        {
            var dbInfo = await Db.Dbinfos.FirstOrDefaultAsync();
            
            fromAccount = string.IsNullOrEmpty(defaultAccountFromQuery) ? null : defaultAccountFromQuery;
            toAccount = null;
            amount = null;
            date = DateTime.Now;
            description = null;
            category = null;
            author = dbInfo?.Nome ?? string.Empty;
        }
    }

    private async Task SaveTransaction()
    {
        error = string.Empty;
        
        // Start an explicit transaction
        using var transaction = await Db.Database.BeginTransactionAsync();

        try
        {
            var t = id > -1
                ? await Db.Movimentis
                    .Include(m => m.IdgirocontoNavigation)
                    .FirstOrDefaultAsync(m => m.Id == id.Value)
                    ?? throw new Exception("Transaction not found")
                : new();

            t.Tipo = fromAccount ?? throw new Exception("From account is required");
            t.Soldi = amount.GetValueOrDefault();
            t.Data = date;
            t.Descrizione = description ?? string.Empty;
            t.MacroArea = category ?? string.Empty;
            t.Nome = author ?? throw new Exception("Author is required");

            if (!string.IsNullOrEmpty(toAccount))
            {
                var t2 = t.IdgirocontoNavigation ?? new();
                t2.Tipo = toAccount;
                t2.Soldi = -t.Soldi;
                t2.Data = t.Data;
                t2.Descrizione = t.Descrizione;
                t2.MacroArea = t.MacroArea;
                t2.Nome = t.Nome;

                if (t2.Id < 1)
                {
                    // If it's a completely new single transaction, add it first so it gets an ID
                    if (id == -1)
                        Db.Movimentis.Add(t);

                    Db.Movimentis.Add(t2);
                    await Db.SaveChangesAsync(); // Saves t2 (and t if new) to generate IDs
                }

                // Sync the circular relationship explicitly so EF Core binds them perfectly
                t.IdgirocontoNavigation = t2;
                t2.IdgirocontoNavigation = t;
            }
            else if (t.IdgirocontoNavigation != null && t.IdgirocontoNavigation.Id > -1)
            {
                var linked = t.IdgirocontoNavigation;
                t.Idgiroconto = null;
                t.IdgirocontoNavigation = null;
                Db.Movimentis.Remove(linked);
            }

            // If it's a new standard transaction (not a transfer), add it now
            if (id == -1 && string.IsNullOrEmpty(toAccount))
            {
                Db.Movimentis.Add(t);
            }

            // EF Core automatically tracks changes for existing items.
            // No manual Db.Movimentis.Update(t) is needed here!
            await Db.SaveChangesAsync();
            
            // Commit the transaction
            await transaction.CommitAsync();
            NavigationManager.NavigateTo(returnUrl);
        }
        catch (Exception ex)
        {
            // Rollback on error
            await transaction.RollbackAsync();
            error = $"{ex.Message}: {ex.InnerException?.Message}";
        }
    }

    private async Task DeleteTransaction()
    {
        error = string.Empty;

        if (id == null || id < 0)
            return;
        
        var isGiroconto = await Db.Movimentis
            .Where(m =>
                m.Id == id
                && m.Idgiroconto > -1
            )            
            .AnyAsync();

        var confirmationMessage = isGiroconto
            ? "Are you sure you want to delete this internal transfer? Both linked transactions will be removed."
            : "Are you sure you want to delete this transaction?";

        var confermato = await JS.InvokeAsync<bool>("confirm", confirmationMessage);
        if (!confermato)
            return;

        // Avviamo la transazione per gestire il vincolo di integrità
        using var transaction = await Db.Database.BeginTransactionAsync();

        try
        {
            var mainTransaction = await Db.Movimentis.FindAsync(id.Value) 
                ?? throw new Exception("Transaction not found");

            var idGiroconto = mainTransaction.Idgiroconto;
            
            if (isGiroconto && idGiroconto.HasValue && idGiroconto > -1)
            {
                var linkedTransaction = await Db.Movimentis.FindAsync(idGiroconto.Value)
                    ?? throw new Exception("Linked transaction not found");

                // 1. Rompiamo il legame in entrambi i sensi
                mainTransaction.Idgiroconto = null;
                linkedTransaction.Idgiroconto = null;
                
                // Salviamo subito per rimuovere il vincolo dal DB
                await Db.SaveChangesAsync();

                // 2. Rimuoviamo entrambi i record
                Db.Movimentis.Remove(linkedTransaction);
            }

            Db.Movimentis.Remove(mainTransaction);
            await Db.SaveChangesAsync();

            // Confermiamo l'eliminazione definitiva
            await transaction.CommitAsync();
            NavigationManager.NavigateTo(returnUrl);
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            error = $"{ex.Message}: {ex.InnerException?.Message}";
        }
    }

    private async Task OnDescriptionBlur()
    {
        if (!string.IsNullOrWhiteSpace(description))
        {
            var suggestedCategory = await Db.Movimentis
                .Where(m => m.Descrizione == description)
                .GroupBy(m => m.MacroArea)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .FirstOrDefaultAsync();

            if (!string.IsNullOrWhiteSpace(suggestedCategory))
                category = suggestedCategory;
        }
    }

}